# .env.example — commit this file; never commit .env.local
# Copy to .env.local for local dev. In production these live in Vercel env vars.

# --- Public (safe in client bundles) ---
NEXT_PUBLIC_SITE_URL=https://lockandlambert.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lockandlambert.com

# Supabase — separate L&L instance (per v2 spec §7).
# Provision a new project at supabase.com, then paste the URL + anon key here.
# A new instance is recommended for brand separation (do not commingle with Burgerly's).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Guesty Booking Engine widget (per v2 spec §5) ---
# The Guesty Booking Engine search widget loads two bundles from
#   https://s3.amazonaws.com/guesty-frontend-production/search-bar-production.{js,css}
# and creates the search UI via window.GuestySearchBarWidget.create({siteUrl, color}).
#
# The container DOM id pattern is "search-widget_{WIDGET_ID}". The widget id
# below comes from Guesty: Channels → Booking Website → kebab → "Connect to
# your own website" → the value after "search-widget_" inside the snippet.
#
# Defaults are baked into GuestySearchWidget.tsx for lockandlambert.guestybookings.com
# (IO312PWQ). These env vars exist if you ever need to override them per
# preview deploy or if Guesty rotates the widget ID.
NEXT_PUBLIC_GUESTY_SEARCH_WIDGET_ID=
NEXT_PUBLIC_GUESTY_SITE_URL=

# Per-property booking widget IDs — for sticky widget on /properties/[slug].
# Guesty Lite may not expose per-property widgets; the property detail page
# falls back to a clean "Check availability" CTA linking to the Guesty
# Booking Website backup when these are empty. Verify in Guesty editor under
# each property's settings whether a per-listing widget snippet is available
# (Lite tier may require deep-linking the search widget instead).
NEXT_PUBLIC_GUESTY_LISTING_WIDGET_MAIN_ST_HIDEAWAY=
NEXT_PUBLIC_GUESTY_LISTING_WIDGET_LAMBERT_UNIT_1=
NEXT_PUBLIC_GUESTY_LISTING_WIDGET_LAMBERT_UNIT_2=
NEXT_PUBLIC_GUESTY_LISTING_WIDGET_LAMBERT_HOUSE=

# Fallback URL on the Guesty Booking Website (backup booking surface)
NEXT_PUBLIC_GUESTY_BOOKING_WEBSITE_URL=https://lockandlambert.guestybookings.com

# --- Server-only (NEVER expose in client / never prefix with NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- CI-only ---
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
